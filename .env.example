# 이 파일을 .env로 복사한 뒤 값을 채운다. (.env는 git에 올리지 않는다)

# ── 필수
OPENAI_API_KEY=
ALPHAVANTAGE_API_KEY=
TAVILY_API_KEY=

# ── RAG 적재(python -m ingestion.load)에 필요: SEC는 연락처가 들어간 User-Agent를 요구한다
SEC_EDGAR_USER_AGENT="Your Name your@email.com"

# ── 선택 (비우면 기본값)
DATABASE_URL=postgresql://invest:invest@localhost:5432/invest
OPENAI_MODEL=gpt-4o-mini            # heavy: 요약·리포트 작성·과거 비교
OPENAI_MODEL_LIGHT=gpt-4.1-nano     # light: 관련성 검사·검색어 재작성·숫자 검증
LLM_ROUTING=tiered                  # tiered | single(모두 heavy, 비교 실험용)
RELEVANCE_JUDGE=v2                  # v1(LLM이 yes/no) | v2(LLM은 근거 문서만, 판정은 코드)
LLM_PROVIDER=openai                 # openai | ollama(로컬 무료 모델로 실험할 때)
OLLAMA_MODEL=qwen3:8b               # ollama일 때 heavy
OLLAMA_MODEL_LIGHT=qwen2.5:3b       # ollama일 때 light
EMBEDDING_MODEL=text-embedding-3-small
WEB_SEARCH_MODE=fixed        # fixed | agent
VERIFY_ENABLED=false         # true면 리포트 숫자 검증 노드 사용
RAG_TOP_K=4

# ── LangSmith 추적 (키가 없으면 추적만 꺼지고 나머지는 동작)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=invest-report-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
